LOG_RETENTION_DAYS=90
SKIP_MIGRATIONS=false
PRODUCT_PUBLISHING_ENABLED=false
CONTENT_AUTO_UPDATE_ENABLED=false
OPPORTUNITY_AUTO_PUBLISH_ENABLED=false
