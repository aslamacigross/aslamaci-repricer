NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aslamaci_erp
TY_API_KEY=
TY_API_SECRET=
TY_SUPPLIER_ID=
TY_STOREFRONT_CODE=TR
# Hepsiburada entegrasyonu icin servis anahtarini yalniz Railway/env kasasinda tutun.
HB_MERCHANT_ID=
HB_USERNAME=
HB_PASSWORD=
HB_INTEGRATOR_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Tercih edilen production secenegi: pnpm hash-password ile uretin.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGIN=http://localhost:3000
DRY_RUN=true
REPRICER_ENABLED=false
JOBS_ENABLED=true
DEFAULT_CARRIER=TEX
DEFAULT_SERVICE_FEE=13.19
DEFAULT_TARGET_PROFIT=40
DEFAULT_MAX_INCREASE_TL=10
BUYBOX_MAX_AGE_MINUTES=20
GLOBAL_MAX_PRICE_CHANGE_PCT=15
GLOBAL_MAX_DAILY_DECREASE_PCT=5
